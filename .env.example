# ─── Supabase Configuration ────────────────────────────────────────────────
# Required for: Google Login, Database, Storage
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─── Supabase S3 Storage (Optional - only if using file uploads) ───────────
SUPABASE_S3_ACCESS_KEY_ID="your_s3_access_key_id"
SUPABASE_S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"
SUPABASE_S3_REGION="ap-southeast-1"

# ─── Gemini AI (Optional - only if using AI features) ──────────────────────
GEMINI_API_KEY="your_gemini_api_key"

# ─── Resend Email Configuration ─────────────────────────────────────────────
# Required for: Order notifications, Support ticket emails
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# Sender address — must be a verified domain/email in your Resend account
# Free plan: use "onboarding@resend.dev" (sends only to your verified email)
# Production: verify your domain and use "Your Name <noreply@yourdomain.com>"
RESEND_FROM_EMAIL="ZENOV Gaming <onboarding@resend.dev>"

# Admin email — all order & support ticket notifications go here
ADMIN_NOTIFICATION_EMAIL="admin@zenov.gg"

# ─── MongoDB (Optional - currently not actively used) ──────────────────────
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/dbname"
